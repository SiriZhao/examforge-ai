# Backend
ERA_APP_NAME=Exam Review Agent
ERA_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
UPLOAD_DIR=backend/uploads
OUTPUT_DIR=backend/outputs

# OCR providers: local_tesseract, custom_api, openai_vision
# Do not put real API keys in this file.
DEFAULT_OCR_PROVIDER=local_tesseract
OCR_PROVIDER=local_tesseract
OCR_ENDPOINT=
OCR_API_KEY=
CUSTOM_OCR_ENDPOINT=

# LLM providers: mock, openai, custom_openai_compatible, deepseek, qwen
# Do not put real API keys in this file.
DEFAULT_LLM_PROVIDER=mock
LLM_PROVIDER=mock
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
OPENAI_API_KEY=
CUSTOM_LLM_BASE_URL=
