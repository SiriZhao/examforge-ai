APP_NAME=Campus AI Workspace
APP_MODE=cloud
APP_VERSION=0.5.0
ENVIRONMENT=production
PORT=8000
PUBLIC_BASE_URL=
FRONTEND_ORIGIN=
CORS_ORIGINS=
DATABASE_URL=sqlite:////data/workspace.db
STORAGE_BACKEND=local

MAX_UPLOAD_MB=50
MAX_FILES_PER_REQUEST=10
MAX_USER_STORAGE_MB=1024
REQUEST_TIMEOUT_SECONDS=120
JOB_TIMEOUT_SECONDS=600
TEMP_FILE_TTL_HOURS=24

STORAGE_DIR=/data
UPLOAD_DIR=uploads
OUTPUT_DIR=outputs
OCR_CACHE_DIR=cache/ocr

ENABLE_LOCAL_OCR=true
ENABLE_RAPIDOCR=true
ENABLE_TESSERACT=false
ENABLE_CLOUD_SAFE_MODE=true
ENABLE_WEB_SEARCH=false
ENABLE_PYTHON_TOOL=false
FREE_DAILY_MESSAGES=20
FREE_MONTHLY_TOKENS=
LOG_LEVEL=INFO

DEFAULT_LLM_PROVIDER=deepseek
DEFAULT_LLM_MODEL=deepseek-v4-flash
DEFAULT_LLM_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=
OPENAI_API_KEY=

VITE_APP_NAME=CampusForge
VITE_APP_VERSION=0.5.0
VITE_APP_BASE_PATH=/
VITE_APP_URL=
VITE_API_BASE_URL=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_STRIPE_PUBLISHABLE_KEY=

LLM_CONTEXT_BUDGET_CHARS=120000
LLM_CHUNK_CHARS=18000
LLM_CHUNK_OVERLAP_CHARS=1200
LLM_MAX_CHUNKS_PER_ROUND=8
LLM_MAX_REPAIR_CALLS=1
LLM_ENABLE_CHUNK_SUMMARY=true
LLM_ENABLE_FINAL_SYNTHESIS=true

# Legacy desktop/development aliases are still accepted by the backend:
# ERA_UPLOAD_DIR=backend/uploads
# ERA_OUTPUT_DIR=backend/outputs
